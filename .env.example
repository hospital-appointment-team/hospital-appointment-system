APP_ENV=local
APP_TIMEZONE=Asia/Dhaka
SESSION_SECURE=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_appointments
DB_USERNAME=
DB_PASSWORD=
# Booking stays disabled until the hospital supplies its operating policy.
CLINIC_OPEN=
CLINIC_CLOSE=
SLOT_MINUTES=
BOOKING_POLICY_CONFIRMED=false
# Initial proposed policies; confirm before enabling booking.
BOOKING_INCLUDE_TODAY=true
# Optional absolute private path; multiple app hosts must share durable state storage.
STATE_STORAGE_DIR=
